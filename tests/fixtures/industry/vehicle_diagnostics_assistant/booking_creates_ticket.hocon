{
    "agent": "industry/vehicle_diagnostics_assistant",
    "connections": ["direct"],
    "timeout_in_seconds": 600,
    "success_ratio": "1/1",
    "interactions": [
        {
            "sly_data": {
                "vin": "WVWZZZ1KZ8W000001",
                "customer_name": "Alex",
                "current_date": "2026-10-23"
            },
            "text": "My scanner shows P0128 and the heater blows cold air. I'd like to get it fixed.",
            "response": {
                "text": {
                    "gist": ["""
The answer explains the coolant thermostat fault, says the vehicle is safe to drive,
and offers open workshop appointment slots or offers to book an appointment.
"""]
                }
            }
        },
        {
            "text": "Book the slot on 2026-10-27 at 08:00 please. I confirm.",
            "response": {
                "text": {
                    "gist": ["""
The answer confirms the booking for 2026-10-27 at 08:00 and gives a service ticket ID starting with WO-.
"""]
                }
            }
        }
    ]
}
