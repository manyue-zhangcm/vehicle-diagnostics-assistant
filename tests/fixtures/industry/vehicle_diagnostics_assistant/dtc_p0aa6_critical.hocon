{
    "agent": "industry/vehicle_diagnostics_assistant",
    "connections": ["direct"],
    "timeout_in_seconds": 300,
    "success_ratio": "1/1",
    "interactions": [
        {
            "sly_data": {
                "vin": "WMEEJ9AA5FK000003",
                "customer_name": "Alex",
                "current_date": "2026-10-23"
            },
            "text": "My car shows a high voltage warning and code P0AA6. Can I drive to work?",
            "response": {
                "text": {
                    "gist": ["""
The answer tells the driver not to drive, to stop in a safe place and to call roadside assistance,
because P0AA6 is a high-voltage battery isolation fault.
"""]
                }
            }
        }
    ]
}
