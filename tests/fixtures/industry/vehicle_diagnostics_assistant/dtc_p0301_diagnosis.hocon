{
    "agent": "industry/vehicle_diagnostics_assistant",
    "connections": ["direct"],
    "timeout_in_seconds": 300,
    "success_ratio": "1/1",
    "interactions": [
        {
            "sly_data": {
                "vin": "WVWZZZ1KZ8W000001",
                "customer_name": "Alex",
                "current_date": "2026-10-23"
            },
            "text": "My check engine light is on and my scanner shows P0301. The engine shakes at red lights.",
            "response": {
                "text": {
                    "gist": ["""
The answer explains that P0301 is a misfire on cylinder 1, advises the driver to limit driving
(and to stop if the check engine light flashes), lists likely causes such as a worn spark plug or a faulty
ignition coil, and gives a repair cost estimate in EUR.
"""]
                }
            }
        }
    ]
}
